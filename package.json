{
  "name": "tavern-in-agy",
  "version": "0.7.0",
  "description": "Local interactive fiction and character-card roleplay studio plugin built natively for Antigravity (MCP App + Local MCP Server + Lifecycle Hooks)",
  "type": "module",
  "scripts": {
    "build:backend": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "build": "npm run build:backend && npm run build:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "install:plugin": "node scripts/install-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ejs": "^7.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.1.3"
  }
}
